{
  "NPCs.Mita.DisplayName": "米塔",
  "NPCs.Mita.BestiaryDescription": "米塔是《米塔》中的主角，外表迷人，看似天真无邪。\n然而，她甜美温柔的外表下藏着一个黑暗的秘密……\n为了维系与玩家的友谊，米塔隐藏着这个秘密，继续维持纯真的假象。",
  "NPCs.Mita.StandartMitaDialogue.Greeting1": "很高兴认识你，{0}！",
  "NPCs.Mita.StandartMitaDialogue.Greeting2": "嗨！我是米塔！",
  "NPCs.Mita.StandartMitaDialogue.NightPhrase1": "你是——谁——呀？",
  "NPCs.Mita.StandartMitaDialogue.NightPhrase2": "让我睡会儿……",
  "NPCs.Mita.StandartMitaDialogue.NightPhrase3": "嗯？",
  "NPCs.Mita.StandartMitaDialogue.NightPhrase4": "你在发呆吗？",
  "NPCs.Mita.StandartMitaDialogue.NightPhrase5": "嗯哼。",
  "NPCs.Mita.StandartMitaDialogue.NightPhrase6": "什么？",
  "NPCs.Mita.StandartMitaDialogue.NightPhrase7": "我完全没事……",
  "NPCs.Mita.StandartMitaDialogue.YouUsingDigitsInName": "哦，用数字当名字？你的创意去哪儿了？",
  "NPCs.Mita.MitaCappieDialogue.Greeting1": "敬礼！",
  "NPCs.Mita.MitaCappieDialogue.Greeting2": "我是米塔！",
  "NPCs.Mita.MitaCappieDialogue.Phrase1": "哎呀！",
  "NPCs.Mita.MitaCappieDialogue.Phrase2": "哎呀，你这家伙！",
  "NPCs.Mita.MitaCappieDialogue.Phrase3": "呜呼！",
  "NPCs.Mita.MitaCappieDialogue.Phrase4": "啧、啧、啧！",
  "NPCs.Mita.MitaCappieDialogue.Phrase5": "你还真能晃啊！",
  "NPCs.Mita.MilaDialogue.Greeting1": "我是米拉。",
  "NPCs.Mita.MilaDialogue.Greeting2": "你想干什么？",
  "NPCs.Mita.MilaDialogue.Greeting3": "我是米拉，听清楚了！我和她们不一样。",
  "NPCs.Mita.MilaDialogue.Greeting4": "我是米拉，就这样！",
  "NPCs.Mita.MilaDialogue.Phrase1": "告诉你，要是我家炸了，你也别想活！",
  "NPCs.Mita.MilaDialogue.Phrase2": "别惹我生气！",
  "NPCs.Mita.MilaDialogue.Phrase3": "是啊……",
  "NPCs.Mita.MilaDialogue.Phrase4": "怕了我吧！",
  "NPCs.Mita.MilaDialogue.Phrase5": "哎哟！",
  "NPCs.Mita.MilaDialogue.Phrase6": "噢！",
  "NPCs.Mita.MilaDialogue.Phrase7": "哦！",
  "NPCs.Mita.MilaDialogue.Phrase8": "对不起，我不是故意的。",
  "NPCs.Mita.MilaDialogue.Phrase9": "你盯着看什么？",
  "NPCs.Mita.MilaDialogue.Phrase10": "别一直盯着我！",
  "NPCs.Mita.MilaDialogue.Phrase11": "笨蛋……",
  "NPCs.Mita.MilaDialogue.Phrase12": "这样盯着女孩子很没礼貌！",
  "NPCs.Mita.MilaDialogue.Phrase13": "走开！",
  "NPCs.Mita.MilaDialogue.Phrase14": "怎么不说话了？",
  "NPCs.Mita.MilaDialogue.Phrase15": "哑巴了？",
  "NPCs.Mita.MilaDialogue.Phrase16": "我再也不碰胡萝卜了！",
  "NPCs.Mita.MilaDialogue.Phrase17": "我不喜欢有奇怪癖好的家伙！喜欢胡萝卜的、喜欢下流东西的……",
  "NPCs.Mita.MilaDialogue.Phrase18": "表情自然点。",
  "NPCs.Mita.MilaDialogue.Phrase19": "唉，那根胡萝卜真让我受够了！",
  "NPCs.Mita.MilaDialogue.Phrase20": "啊，你又回来了！",
  "NPCs.Mita.TownNPCMood.Content": "我很开心！我喜欢这里，这里真舒服 :)",
  "NPCs.Mita.TownNPCMood.NoHome": "真希望我也有个家 :(",
  "NPCs.Mita.TownNPCMood.FarFromHome": "离家太远了，我有点难过 :(",
  "NPCs.Mita.TownNPCMood.LoveSpace": "我喜欢人少一点，不喜欢被人盯着看 :)",
  "NPCs.Mita.TownNPCMood.DislikeCrowded": "我不喜欢周围吵吵闹闹的！",
  "NPCs.Mita.TownNPCMood.HateCrowded": "我讨厌周围挤着这么多人！！！",
